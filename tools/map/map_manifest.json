{
  "_about": "Памятка: что должно быть у каждой карты (data/maps/<карта>/), для какой ситуации и чем делается. Проверка — python3 tools/map/map_check.py [карта]. Новая карта: положить исходники (README в папке карты), собрать набор — python3 tools/map/map_build.py <карта> (шаг demos запекает всё из демок, tools/map/demos_bake.py), потом map_check.py — пустых строк быть не должно. «need: нет скрипта» — данных нет ни у одной карты: нужен новый скрипт запекания (одним для всех карт).",
  "preparation": {
    "entry": "tools/map/map_build.py MAP --prepare OUTPUT",
    "validate": "tools/map/map_build.py MAP --check-prepared OUTPUT",
    "package": "tools/map/map_build.py MAP --package OUTPUT.simmap --strict",
    "retakeLayout": "tools/map/map_build.py MAP --retake-layout OUTPUT.json --site-spec SPEC.json",
    "evidenceSchemaVersion": 1,
    "coverage": {
      "checkJump": {"section": "reviewCandidates", "source": "professional_demo", "meaning": "vertical return proxy; visibility and intent need review"},
      "boost": {"section": "reviewCandidates", "source": "professional_demo", "meaning": "vertical teammate proximity proxy; contact and floors need review"},
      "awpActive": {"section": "observerFacts", "source": "professional_demo", "meaning": "held AWP at sampled positions; purchase/ownership is a separate contract"},
      "roleEvidence": {"section": "observerFacts", "source": "professional_demo", "meaning": "player and side observations; roster assignments and IGL require owner evidence"},
      "demorounds": {"section": "demoViewerExport", "source": "professional_demo", "meaning": "existing viewer format selected by demo and round"},
      "save": {"section": "reviewCandidates", "source": "professional_demo", "meaning": "last complete alive sample plus round outcome; intent needs review"},
      "siteEntries": {"section": "reviewCandidates", "source": "professional_demo_and_map_annotation", "meaning": "sampled crossings; 2D projection is a proxy; a site annotation requires the same geometry revision"},
      "clutchSamples": {"section": "observerFacts", "source": "professional_demo", "meaning": "complete sampled 1vN alive census and round context"}
    },
    "futureMap": {
      "automatic": ["radarTransform", "navPolygonsAndHeights", "directedNavLinksAndLadders", "geometryLayersAndMaterials", "sourceHashes", "packageRoundTrip"],
      "mapAnnotation": ["semanticZonesAndAliases", "floorAwareSiteEntries", "coverTypesAndExposure", "objectivesAndSpawns", "reviewedVerticalTransitions"],
      "professionalDemo": ["demoHeaderAndRevision", "observedTacticalContext", "geometryBoundReplayEvidence"],
      "ownerDecision": ["rosterAndRoleAssignments", "mapVersionMigration", "inclusionAndGameplayCalibration"],
      "scenarioLab": ["mapAndBuildIdentity", "geometryAndNavIdentity", "snapshotAndSourceType", "worldXYZAndStance", "linkTypeAndReachability", "dynamicObjectsAndObjective", "knowledgeSeparateFromObserverFacts", "exactReplayVersusAdaptedScenario"]
    }
  },
